# /etc/caddy/Caddyfile
# Main domain is declared once. Every application contributes only routes.
{
    email admin@annushkaaaaa.store
}

annushkaaaaa.store {
    encode zstd gzip
    import /etc/caddy/apps/*.caddy
}

# /etc/caddy/apps/life-manager.caddy
# Caddy runs on the host, so proxy to the localhost port published by Docker.
redir /life-manager /life-manager/ 308

handle_path /life-manager/* {
    reverse_proxy 127.0.0.1:5086
}

# Future application example:
# redir /another-app /another-app/ 308
# handle_path /another-app/* {
#     reverse_proxy 127.0.0.1:5087
# }
